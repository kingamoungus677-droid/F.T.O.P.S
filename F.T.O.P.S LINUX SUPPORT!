rainbow() {
    local text="$1"
    local colors=("\e[36m" "\e[34m" "\e[35m" "\e[31m" "\e[33m" "\e[32m")
    local len=${#text}
    for (( i=0; i<len; i++ )); do
        local color=${colors[$((i % 6))]}
        echo -ne "${color}${text:$i:1}\e[0m"
    done
    echo ""
}

type_text() {
    local text="$1"
    local delay="${2:-0.015}"
    local len=${#text}
    for (( i=0; i<len; i++ )); do
        echo -ne "\e[33m${text:$i:1}\e[0m"
        sleep "$delay"
    done
    echo ""
}

