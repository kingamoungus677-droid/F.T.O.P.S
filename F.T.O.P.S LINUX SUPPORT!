        echo -e "\n\e[36m[STEP 1/3] Repairing package manager...\e[0m"
        if command -v dpkg &>/dev/null; then
            dpkg --configure -a
            apt-get install -f -y
        elif command -v pacman &>/dev/null; then
            pacman -Syu --noconfirm
        fi

        echo -e "\n\e[36m[STEP 2/3] Repairing flatpak applications...\e[0m"
        if command -v flatpak &>/dev/null; then
            flatpak repair
        fi

        echo -e "\n\e[36m[STEP 3/3] Disk Diagnostics Info...\e[0m"
        echo "To run full filesystem checks on unmounted drives, use: sudo fsck -f /dev/sdX"

        echo -e "\n\e[32m🐾 System maintenance completed successfully!\e[0m"
    '
    paw 'System Repair Execution Completed!'
else
    paw 'Startup Repair skipped. Your session is complete.'
fi

sleep 2
exit 0
