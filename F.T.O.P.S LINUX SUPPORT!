# Helper function to set Linux Wallpaper across Desktop Environments
set_linux_wallpaper() {
    local img_path="$1"
    if command -v gsettings &>/dev/null; then
        # GNOME / Ubuntu / Cinnamon
        gsettings set org.gnome.desktop.background picture-uri "file://$img_path" 2>/dev/null
        gsettings set org.gnome.desktop.background picture-uri-dark "file://$img_path" 2>/dev/null
    elif command -v plasma-apply-wallpaperimage &>/dev/null; then
        # KDE Plasma
        plasma-apply-wallpaperimage "$img_path" 2>/dev/null
    elif command -v feh &>/dev/null; then
        # X11 Window Managers (i3, Openbox, XFCE fallback)
        feh --bg-fill "$img_path" 2>/dev/null
    fi
}

paw() {
